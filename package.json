    "predev": "node scripts/generate-qr.mjs",
    "prepreview:offline": "node scripts/generate-qr.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "qrcode": "^1.5.4",
    "vite": "^6.4.5"
  }
