{
  "name": "mm-service-center",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:offline": "node scripts/standalone.mjs",
